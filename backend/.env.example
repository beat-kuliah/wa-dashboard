DATABASE_URL=postgres://postgres:Admin123@localhost:5432/wa_dashboard?sslmode=disable
REDIS_URL=redis://:Admin123@localhost:6379/0
JWT_SECRET=change-me-in-production-use-long-random-string
PORT=8080
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL=720h
MIGRATIONS_PATH=db/migrations
ENVIRONMENT=development
# Public self-service registration (default off; use platform admin to provision tenants)
PUBLIC_REGISTRATION_ENABLED=false
# Bootstrap the first platform admin on API startup (required for /admin/*)
PLATFORM_ADMIN_EMAIL=ops@wa-dashboard.local
PLATFORM_ADMIN_PASSWORD=change-me-platform-admin
PLATFORM_ADMIN_FULL_NAME=Platform Admin
